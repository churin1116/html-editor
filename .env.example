# Image uploads to Cloudflare R2 (paste / drag-and-drop in the editor).
#
# Only two values live here (non-secret):
#   - R2_BUCKET_NAME   the bucket you created on Cloudflare R2
#   - R2_PUBLIC_URL    the pub-xxxxx.r2.dev URL of that bucket
#
# The three secrets (R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY)
# are NOT written here. They are loaded from macOS Keychain at runtime by
# `scripts/with-r2-secrets.sh`, which `pnpm dev` runs automatically.
#
# Copy this file to .env.local and fill in your bucket info.

R2_BUCKET_NAME=html-editor-images
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxx.r2.dev
