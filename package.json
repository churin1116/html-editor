{
  "name": "html-editor",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first WYSIWYG editor for HTML and Markdown files anywhere on disk. Run pnpm dev, bookmark localhost, edit notes without opening a code editor.",
  "license": "MIT",
  "author": "churin",
  "keywords": [
    "html-editor",
    "markdown-editor",
    "wysiwyg",
    "tiptap",
    "nextjs",
    "local-first",
    "notes"
  ],
  "scripts": {
    "dev": "./scripts/with-r2-secrets.sh next dev -p 26509",
    "build": "next build",
    "start": "./scripts/with-r2-secrets.sh next start -p 26509",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1045.0",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.42.1",
    "@tiptap/core": "^3.23.1",
    "@tiptap/extension-image": "^3.0.0",
    "@tiptap/extension-link": "^3.0.0",
    "@tiptap/extension-table": "^3.0.0",
    "@tiptap/extension-table-cell": "^3.0.0",
    "@tiptap/extension-table-header": "^3.0.0",
    "@tiptap/extension-table-row": "^3.0.0",
    "@tiptap/pm": "^3.0.0",
    "@tiptap/react": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "@uiw/react-codemirror": "^4.25.9",
    "chokidar": "^5.0.0",
    "next": "15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "pnpm@9.0.0"
}
